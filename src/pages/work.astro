---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarField from '../components/StarField.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { abridgeRole, buildersPortal, abridgeWins, priorRoles } from '../data/experience';
---

<BaseLayout
  title="The Work — grym.tech"
  description="Professional experience and platform engineering work"
>
  <StarField />
  <Nav />
  <main>
    <section class="page-header section">
      <div class="container">
        <h1 class="reveal">The Work</h1>
        <p class="page-subtitle mono reveal">// 12+ years building platforms</p>
      </div>
    </section>

    <section class="abridge-section section">
      <div class="container">
        <div class="role-header reveal">
          <div class="role-meta">
            <span class="company-name">{abridgeRole.company}</span>
            <span class="role-divider" aria-hidden="true">/</span>
            <span class="role-title">{abridgeRole.title}</span>
          </div>
          <div class="role-details mono">
            <span class="role-period">{abridgeRole.period}</span>
            <span class="role-divider" aria-hidden="true">·</span>
            <span class="role-location">{abridgeRole.location}</span>
          </div>
        </div>

        <p class="role-summary reveal">{abridgeRole.summary}</p>

        <!-- Builders Portal — Crown Jewel -->
        <div class="featured-win glass-card reveal">
          <div class="featured-win-header">
            <div class="featured-win-title-row">
              <h2 class="featured-win-title">{buildersPortal.title}</h2>
              <span class="featured-win-period mono">{buildersPortal.period}</span>
            </div>
            <p class="featured-win-one-liner">{buildersPortal.oneLiner}</p>
            <p class="featured-win-subtitle mono">{buildersPortal.subtitle}</p>
          </div>

          <div class="capabilities-grid">
            {buildersPortal.capabilities.map((cap) => (
              <div class="capability-item">
                <h4 class="capability-name">{cap.name}</h4>
                <p class="capability-desc">{cap.description}</p>
              </div>
            ))}
          </div>

          <div class="portal-stats">
            {buildersPortal.stats.map((stat) => (
              <div class="portal-stat">
                <span class="portal-stat-value">{stat.value}</span>
                <span class="portal-stat-label">{stat.label}</span>
              </div>
            ))}
          </div>

          <div class="architecture-section">
            <h4 class="architecture-heading mono">// architecture & platform maturity</h4>
            <div class="architecture-grid">
              {buildersPortal.architecture.map((item) => (
                <div class="architecture-item">
                  <h5 class="architecture-title">{item.title}</h5>
                  <p class="architecture-detail">{item.detail}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="featured-win-footer">
            <p class="strategic-value">{buildersPortal.strategicValue}</p>
          </div>
        </div>

        <!-- Other Wins Grid -->
        <h2 class="wins-heading reveal">Marquee Wins</h2>
        <div class="wins-grid">
          {abridgeWins.map((win) => (
            <div
              class="win-card glass-card reveal"
              style={`--win-accent: var(--accent-${win.accent}); --win-accent-rgb: ${win.accent === 'cyan' ? '56, 189, 248' : '245, 158, 11'};`}
            >
              <div class="win-card-header">
                <span class="win-category mono">{win.category}</span>
              </div>
              <h3 class="win-title">{win.title}</h3>
              <p class="win-body">{win.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="prior-section section">
      <div class="container">
        <h2 class="section-title reveal">Prior Roles</h2>
        <p class="section-subtitle reveal">// the path that got here</p>

        <div class="prior-grid">
          {priorRoles.map((role) => (
            <div class="prior-card glass-card reveal">
              <div class="prior-card-header">
                <div class="prior-company-row">
                  <span class="prior-company">{role.company}</span>
                  {role.acquired && (
                    <span class="prior-acquired mono">{role.acquired}</span>
                  )}
                </div>
                <div class="prior-meta mono">
                  <span class="prior-title">{role.title}</span>
                  <span class="prior-divider" aria-hidden="true">·</span>
                  <span class="prior-period">{role.period}</span>
                  {role.location && (
                    <>
                      <span class="prior-divider" aria-hidden="true">·</span>
                      <span class="prior-location">{role.location}</span>
                    </>
                  )}
                </div>
              </div>
              <ul class="prior-bullets">
                {role.bullets.map((bullet) => (
                  <li class="prior-bullet">{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ===== Page Header ===== */
  .page-header {
    padding-top: 8rem;
    padding-bottom: 2rem;
  }

  .page-header h1 {
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--accent-cyan);
    font-size: 1rem;
    margin-bottom: 0;
  }

  /* ===== Abridge Role Header ===== */
  .role-header {
    margin-bottom: 1.25rem;
  }

  .role-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.375rem;
  }

  .company-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-amber);
  }

  .role-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .role-divider {
    color: var(--text-muted);
  }

  .role-details {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .role-summary {
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 840px;
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
  }

  /* ===== Builders Portal — Featured Card ===== */
  .featured-win {
    border-left: 3px solid var(--accent-amber);
    background: rgba(20, 30, 55, 0.75);
    margin-bottom: 3rem;
    padding: 2rem;
  }

  .featured-win:hover {
    border-left-color: var(--accent-amber);
    box-shadow: 0 0 32px rgba(245, 158, 11, 0.15);
  }

  .featured-win-header {
    margin-bottom: 1.75rem;
  }

  .featured-win-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .featured-win-title {
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    color: var(--accent-amber);
    line-height: 1.3;
  }

  .featured-win-period {
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 999px;
    white-space: nowrap;
    align-self: flex-start;
  }

  .featured-win-one-liner {
    color: var(--text-primary);
    font-size: 1.05rem;
    line-height: 1.7;
    font-weight: 500;
    margin-bottom: 0.625rem;
  }

  .featured-win-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Capabilities Grid */
  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .capability-item {
    background: rgba(10, 14, 23, 0.5);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1rem 1.125rem;
  }

  .capability-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 0.375rem;
  }

  .capability-name::before {
    content: '— ';
    color: var(--text-muted);
  }

  .capability-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Portal Stats Strip */
  .portal-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    padding: 1.25rem;
    background: rgba(10, 14, 23, 0.5);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
  }

  .portal-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
    padding: 0.5rem 0.25rem;
  }

  .portal-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-amber);
    font-family: var(--font-mono);
    line-height: 1;
  }

  .portal-stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Architecture Section */
  .architecture-section {
    margin-bottom: 1.75rem;
  }

  .architecture-heading {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    margin-bottom: 0.875rem;
    letter-spacing: 0.03em;
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.875rem;
  }

  .architecture-item {
    background: rgba(10, 14, 23, 0.4);
    border: 1px solid rgba(56, 189, 248, 0.12);
    border-radius: 8px;
    padding: 0.875rem 1rem;
  }

  .architecture-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
    line-height: 1.3;
  }

  .architecture-detail {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .featured-win-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .strategic-value {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
  }

  /* ===== Wins Grid ===== */
  .wins-heading {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .wins-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .win-card {
    border-top: 2px solid rgba(var(--win-accent-rgb), 0.35);
  }

  .win-card:hover {
    border-top-color: rgba(var(--win-accent-rgb), 0.7);
    box-shadow: 0 0 24px rgba(var(--win-accent-rgb), 0.12);
  }

  .win-card-header {
    margin-bottom: 0.625rem;
  }

  .win-category {
    font-size: 0.7rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgba(var(--win-accent-rgb), 0.08);
    border: 1px solid rgba(var(--win-accent-rgb), 0.25);
    color: var(--win-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .win-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.625rem;
    line-height: 1.3;
  }

  .win-body {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* ===== Prior Roles ===== */
  .prior-section {
    border-top: 1px solid var(--border-subtle);
  }

  .prior-grid {
    display: grid;
    gap: 1.25rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .prior-card {
    padding: 1.5rem;
  }

  .prior-card-header {
    margin-bottom: 1rem;
  }

  .prior-company-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin-bottom: 0.375rem;
  }

  .prior-company {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .prior-acquired {
    font-size: 0.7rem;
    color: var(--text-muted);
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
  }

  .prior-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .prior-title {
    color: var(--accent-cyan);
  }

  .prior-divider {
    color: var(--text-muted);
  }

  .prior-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .prior-bullet {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
    padding-left: 1.125rem;
    position: relative;
  }

  .prior-bullet::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .page-header {
      padding-top: 6rem;
    }

    .capabilities-grid {
      grid-template-columns: 1fr;
    }

    .wins-grid {
      grid-template-columns: 1fr;
    }

    .featured-win-title-row {
      flex-direction: column;
    }

    .role-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .portal-stats {
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    }

    .architecture-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
