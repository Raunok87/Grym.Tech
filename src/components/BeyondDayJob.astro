---
const vignettes = [
  {
    title: 'Voice AI from Scratch',
    accent: 'var(--accent-cyan)',
    accentRgb: '56, 189, 248',
    body: `Built a complete voice pipeline: wake word detection → speech-to-text → LLM reasoning → text-to-speech. Not using a framework — raw audio processing, WebSocket bridges between Go and Python, and a personality system that makes Claude speak with a Cajun accent.`,
  },
  {
    title: 'Real-time at 60fps',
    accent: 'var(--accent-amber)',
    accentRgb: '245, 158, 11',
    body: `Game servers that synchronize state across clients at tick rate. Spatial hashing for collision, pathfinding for mob AI, ability resolution for 54 D&D abilities. When your latency budget is one frame, you learn distributed systems from the inside out.`,
  },
  {
    title: 'AI That Ships Code',
    accent: 'var(--accent-cyan)',
    accentRgb: '56, 189, 248',
    body: `Grym doesn't just answer questions — it SSHs into the homelab, clones repos, writes code, runs tests, and opens PRs. 150+ skills, channel-scoped permissions, destructive operation guardrails. A production AI agent, not a chatbot.`,
  },
  {
    title: 'Zero-Copy Video Pipelines',
    accent: 'var(--accent-amber)',
    accentRgb: '245, 158, 11',
    body: `Rust + GStreamer + ONNX Runtime. Real-time AI segmentation at <16ms per frame. Dual virtual camera backends (v4l2loopback + PipeWire). The kind of systems programming that makes you dangerous in any stack.`,
  },
  {
    title: 'The Homelab as a Platform',
    accent: 'var(--accent-cyan)',
    accentRgb: '56, 189, 248',
    body: `Ubuntu 24.04, ZFS, Docker Compose, Caddy with wildcard certs, AdGuard DNS, Tailscale mesh, GitOps deploys via GitHub Actions. Same disciplines as cloud platform work, but the on-call rotation is just me at 11pm.`,
  },
];
---

<section class="beyond section" id="beyond">
  <div class="container">
    <h2 class="section-title reveal">Beyond the Day Job</h2>
    <p class="section-subtitle reveal">// where curiosity meets compilers</p>

    <div class="vignettes">
      {vignettes.map((v, i) => (
        <div
          class={`vignette-card reveal ${i % 2 !== 0 ? 'vignette-offset' : ''}`}
          style={`--accent: ${v.accent}; --accent-rgb: ${v.accentRgb};`}
        >
          <div class="vignette-header">
            <span class="vignette-number mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="vignette-title">{v.title}</h3>
          </div>
          <p class="vignette-body">{v.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .vignettes {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .vignette-card {
    padding: 1.75rem 2rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-card);
    border-radius: 0 12px 12px 0;
    transition: border-color var(--transition-base), background var(--transition-base), box-shadow var(--transition-base);
  }

  .vignette-card:hover {
    background: var(--bg-card-hover);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 16px rgba(var(--accent-rgb), 0.06);
  }

  .vignette-offset {
    margin-left: 3rem;
  }

  .vignette-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .vignette-number {
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .vignette-title {
    font-size: 1.2rem;
    color: var(--text-primary);
  }

  .vignette-body {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .vignette-offset {
      margin-left: 0;
    }

    .vignette-card {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
