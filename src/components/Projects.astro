---
import { projects } from '../data/projects';

const featured = projects.filter(p => p.featured);

// Map known project slugs to detail pages
const detailPages: Record<string, string> = {
  'Gambit': '/gambit',
  'Grym': '/grym',
};

function getDetailLink(title: string): string | null {
  for (const [key, href] of Object.entries(detailPages)) {
    if (title.toLowerCase().includes(key.toLowerCase())) return href;
  }
  return null;
}
---

<section class="projects section" id="projects">
  <div class="container">
    <h2 class="section-title reveal">Featured Projects</h2>
    <p class="section-subtitle reveal">// what ships after hours</p>

    <div class="projects-grid">
      {featured.map((project, i) => {
        const link = getDetailLink(project.title);
        const accentRgb = project.accent === 'cyan' ? '56, 189, 248' : '245, 158, 11';
        return (
          <div
            class="project-card glass-card reveal"
            style={`--card-accent: var(--accent-${project.accent}); --card-accent-rgb: ${accentRgb};`}
          >
            <div class="project-header">
              <span class="project-number mono">{String(i + 1).padStart(2, '0')}</span>
              <div class="project-badges">
                {project.current && <span class="project-active mono">active</span>}
                <span class="project-category mono">{project.category}</span>
              </div>
            </div>
            <h3 class="project-title">
              {link ? <a href={link} class="project-title-link">{project.title}</a> : project.title}
            </h3>
            <p class="project-desc">{project.description}</p>
            {project.tech && project.tech.length > 0 && (
              <div class="project-tech">
                {project.tech.map((t: string) => (
                  <span class="tech-pill mono">{t}</span>
                ))}
              </div>
            )}
            {link && (
              <a href={link} class="project-detail-link mono">→ details</a>
            )}
          </div>
        );
      })}
    </div>

    <div class="projects-all reveal">
      <a href="/projects" class="projects-all-link mono">→ view all projects</a>
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border-left: 3px solid var(--card-accent);
  }

  .project-card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4), 0 0 24px rgba(var(--card-accent-rgb), 0.06);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .project-number {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .project-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .project-active {
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.4);
    color: #22c55e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-category {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(var(--card-accent-rgb), 0.08);
    border: 1px solid rgba(var(--card-accent-rgb), 0.25);
    color: var(--card-accent);
  }

  .project-title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .project-title-link {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .project-title-link:hover {
    color: var(--card-accent);
  }

  .project-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    flex: 1;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tech-pill {
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .project-detail-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--card-accent);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast), letter-spacing var(--transition-fast);
  }

  .project-detail-link:hover {
    color: var(--accent-amber);
    letter-spacing: 0.08em;
  }

  .projects-all {
    text-align: center;
  }

  .projects-all-link {
    display: inline-block;
    color: var(--accent-cyan);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    padding: 0.5rem 1.5rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 999px;
    transition: background var(--transition-base), border-color var(--transition-base), letter-spacing var(--transition-fast);
  }

  .projects-all-link:hover {
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.6);
    color: var(--accent-cyan);
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
